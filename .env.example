# ── Firebase ──────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# ── Cloudinary ────────────────────────────────────────────────────────────
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# ── EmailJS ───────────────────────────────────────────────────────────────
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_TEMPLATE_REQUEST=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_ACCEPTED=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_REJECTED=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_CANCELLED=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_AUTOCANCELLED=template_xxxxxxx
VITE_EMAILJS_TEMPLATE_COMPLETED=template_xxxxxxx
